<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <parent>
        <artifactId>hypatia-lib-scala</artifactId>
        <groupId>com.gestamp.hypatia</groupId>
        <version>1.2.3</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>hypatia-lib-scala-lakehouse</artifactId>
    <version>1.2.70-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <hypatia-version>1.0.95</hypatia-version>
    </properties>

    <scm>
        <connection>scm:git:https://industry40@dev.azure.com/industry40/Big%20Data/_git/hypatia-lib-scala</connection>
        <developerConnection>scm:git:https://industry40@dev.azure.com/industry40/Big%20Data/_git/hypatia-lib-scala</developerConnection>
        <url>https://industry40@dev.azure.com/industry40/Big%20Data/_git/hypatia-lib-scala</url>
        <tag>hypatia-lib-scala-lakehouse-1.2.66</tag>
    </scm>

    <repositories>
        <repository>
            <id>Hypatia_scala</id>
            <url>https://pkgs.dev.azure.com/industry40/ec087ba5-f7f2-43b3-b432-216f20d47a5c/_packaging/Hypatia_scala/maven/v1</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.gestamp.hypatia</groupId>
            <artifactId>hypatia-lib-scala-commons</artifactId>
            <version>1.2.96</version>
        </dependency>
        <dependency>
            <groupId>com.gestamp.hypatia</groupId>
            <artifactId>hypatia-lib-scala-integration</artifactId>
            <version>1.2.95</version>
        </dependency>
        <dependency>
            <groupId>com.gestamp.hypatia</groupId>
            <artifactId>hypatia-lib-scala-quality</artifactId>
            <version>1.2.87</version>
        </dependency>
        <dependency>
            <groupId>com.gestamp.hypatia</groupId>
            <artifactId>hypatia-lib-scala-ingestion</artifactId>
            <version>1.2.86</version>
        </dependency>
        <dependency>
            <groupId>com.github.scopt</groupId>
            <artifactId>scopt_${scala.compatibility}</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.compatibility}</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.delta</groupId>
            <artifactId>delta-spark_2.12</artifactId>
            <scope>provided</scope>
            <version>3.3.3</version>
        </dependency>
        <dependency>
            <groupId>com.databricks</groupId>
            <artifactId>dbutils-api_${scala.compatibility}</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.circe</groupId>
            <artifactId>circe-parser_native0.4_${scala.compatibility}</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <!-- Scalastyle es una herramienta de análisis estático de código fuente Scala que ayuda a garantizar que
            el código cumpla con una serie de estándares y mejores prácticas predefinidos. -->
            <plugin>
                <groupId>org.scalastyle</groupId>
                <artifactId>scalastyle-maven-plugin</artifactId>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <phase>none</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Este plugin permite compilar, ejecutar y probar proyectos Scala utilizando Maven. -->
            <plugin>
                <groupId>net.alchim31.maven</groupId>
                <artifactId>scala-maven-plugin</artifactId>
                <version>4.5.6</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <scalaVersion>${scala.version}</scalaVersion>
                    <args>
                        <arg>-target:jvm-1.8</arg>
                    </args>
                </configuration>
            </plugin>

            <!-- Este plugin es responsable de ejecutar y administrar las pruebas unitarias de un proyecto Maven
            utilizando el marco de pruebas JUnit o TestNG. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.19.1</version>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>

            <!-- Este plugin permite ejecutar pruebas unitarias escritas en Scala utilizando el marco de pruebas de ScalaTest. -->
            <plugin>
                <groupId>org.scalatest</groupId>
                <artifactId>scalatest-maven-plugin</artifactId>
                <version>2.2.0</version>
                <configuration>
                    <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
                    <junitxml>.</junitxml>
                    <filereports>WDF TestSuite.txt</filereports>
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
                <executions>
                    <execution>
                        <id>test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Este plugin permite eliminar archivos y directorios específicos del proyecto durante el ciclo de vida
            de construcción de Maven. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-directory</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                        <configuration>
                            <filesets>
                                <fileset>
                                    <directory>${project.basedir}/spark-events</directory>
                                    <includes>
                                        <include>*</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Este plugin permite crear un archivo JAR que incluye todas las dependencias necesarias para ejecutar
            el proyecto. Además, el plugin puede permitir también la reubicación de ciertos paquetes de clases. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${project.artifactId}-jar-with-dependencies</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>com.fasterxml.jackson</pattern>
                                    <shadedPattern>ms.shaded.com.fasterxml.jackson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.netty</pattern>
                                    <shadedPattern>ms.shaded.io.netty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>reactor.netty</pattern>
                                    <shadedPattern>ms.shaded.reactor.netty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>reactor.util</pattern>
                                    <shadedPattern>ms.shaded.reactor.util</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>2.5.3</version>
                <configuration>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
